# Application Configuration
NODE_ENV=development
APP_URL=http://localhost:3000

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ke_digital_signage?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/ke_digital_signage?schema=public"

# Authentication
AUTH_SECRET="ke-digital-signage-super-secret-key-32-chars-min-length-here!"
AUTH_TRUST_HOST=true

# Redis Cache & Event Pub/Sub
REDIS_URL="redis://localhost:6379"

# S3 Compatible Storage (MinIO / AWS S3 / Cloudflare R2)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="ke-digital-signage-media"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_PUBLIC_BASE_URL="http://localhost:9000/ke-digital-signage-media"

# Google Sheets Integration
GOOGLE_SERVICE_ACCOUNT_JSON=""

# System Keys
ENCRYPTION_KEY="ke-digital-signage-encryption-key-32-bytes!"
CRON_SECRET="ke-cron-secret"
