# Application Configuration
NODE_ENV=development
APP_URL=http://localhost:3000

# Local database (SQLite)
DATABASE_URL="file:./dev.db"

# Production database (Turso/libSQL, recommended for Vercel)
# Leave these empty when developing with local SQLite.
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# Initial admin account used by `npm run db:seed`
SEED_ADMIN_EMAIL="admin@konstanta.edu"
SEED_ADMIN_PASSWORD="replace-with-a-strong-password"

# Authentication
AUTH_SECRET="replace-with-a-random-secret-at-least-32-characters"
AUTH_TRUST_HOST=true

# Redis Cache & Event Pub/Sub
REDIS_URL="redis://localhost:6379"

# S3 Compatible Storage (MinIO / AWS S3 / Cloudflare R2)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="ke-digital-signage-media"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_PUBLIC_BASE_URL="http://localhost:9000/ke-digital-signage-media"

# Google Sheets Integration
GOOGLE_SERVICE_ACCOUNT_JSON=""

# System Keys
ENCRYPTION_KEY="replace-with-a-random-32-byte-encryption-key"
CRON_SECRET="replace-with-a-random-cron-secret"
