# Hanya variabel di bawah ini yang benar-benar dibaca aplikasi.
# Setiap nilai "replace-with-..." wajib diganti sebelum dipakai sungguhan.

# ==================== DATABASE ====================

# Database lokal saat pengembangan (SQLite).
DATABASE_URL="file:./dev.db"

# Database production (Turso/libSQL). Bila diisi, ini menang atas DATABASE_URL.
# Kosongkan saat mengembangkan dengan SQLite lokal.
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# ==================== AKUN ADMIN (hanya dibaca `npm run db:seed`) ====================
# Tidak perlu dipasang di Vercel — aplikasi yang berjalan tidak membacanya.

SEED_ADMIN_EMAIL="admin@konstanta.edu"
# Seed menolak jalan selama nilai di bawah masih teks contoh ini.
SEED_ADMIN_PASSWORD="replace-with-a-strong-password"
# Set "true" hanya bila ingin mengganti password admin yang sudah ada.
# Seed biasa tidak pernah menimpa password yang tersimpan.
SEED_ADMIN_PASSWORD_RESET="false"

# ==================== GOOGLE SHEETS (sumber data akademik) ====================
# Data akademik (cabang, ruangan, tutor, program, kelas, mata pelajaran,
# jadwal) dibaca langsung dari satu URL Sheet yang dikunci di aplikasi —
# tidak disimpan di database ini.
#
# Opsional. Tanpa credential, pembacaan memakai endpoint CSV publik Sheet
# (Sheet harus dapat dibaca siapa pun yang punya link). Mengisinya membuat
# pembacaan memakai Sheets API langsung, yang lebih andal.
GOOGLE_SERVICE_ACCOUNT_JSON=""

# ==================== PERANGKAT PRESENSI ====================
# Alat pembaca RFID/QR mengirim nilai ini sebagai `Authorization: Bearer ...`.
# Tanpa variabel ini, endpoint presensi hanya terbuka saat NODE_ENV=development.
ATTENDANCE_DEVICE_TOKEN="replace-with-a-random-device-token"

# ==================== WHATSAPP (Fonnte) ====================
# FONNTE_TOKEN menang atas nilai yang tersimpan di tabel SystemSetting.
# FONNTE_ENABLED hanya dipakai bila baris `fonnte_wa_enabled` belum pernah
# ada di SystemSetting; setelah ada, isi database yang menang.
FONNTE_TOKEN=""
FONNTE_ENABLED=false
# Dipasang juga di dasbor Fonnte sebagai header `x-webhook-secret`.
# Wajib diisi di production: tanpa ini webhook menolak semua permintaan.
FONNTE_WEBHOOK_SECRET="replace-with-a-random-webhook-secret"

# ==================== PEMELIHARAAN TERJADWAL ====================
# Pembersihan log lama, lihat lib/retention.ts.
# Vercel Cron mengirim nilai ini sebagai `Authorization: Bearer ...`.
# Wajib diisi di production: tanpa ini endpoint pembersihan menolak permintaan.
CRON_SECRET="replace-with-a-random-cron-secret"
