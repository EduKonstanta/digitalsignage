# Application Configuration
NODE_ENV=development
APP_URL=http://localhost:3000

# Local database (SQLite)
DATABASE_URL="file:./dev.db"

# Production database (Turso/libSQL, recommended for Vercel)
# Leave these empty when developing with local SQLite.
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# Initial admin account used by `npm run db:seed`
SEED_ADMIN_EMAIL="admin@konstanta.edu"
# Seed menolak jalan selama nilai di bawah masih teks contoh ini.
SEED_ADMIN_PASSWORD="replace-with-a-strong-password"
# Set "true" hanya bila ingin mengganti password admin yang sudah ada.
# Seed biasa tidak pernah menimpa password yang tersimpan.
SEED_ADMIN_PASSWORD_RESET="false"

# Authentication
AUTH_SECRET="replace-with-a-random-secret-at-least-32-characters"
AUTH_TRUST_HOST=true

# Redis Cache & Event Pub/Sub
REDIS_URL="redis://localhost:6379"

# S3 Compatible Storage (MinIO / AWS S3 / Cloudflare R2)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="ke-digital-signage-media"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_PUBLIC_BASE_URL="http://localhost:9000/ke-digital-signage-media"

# Google Sheets (live data source)
# Data akademik (cabang, ruangan, tutor, program, kelas, mata pelajaran,
# jadwal) dibaca langsung dari satu URL Sheet yang dikunci di aplikasi -
# tidak disimpan di database ini. Tanpa credential, pembacaan memakai
# endpoint CSV publik Sheet (Sheet harus dapat dibaca siapa pun yang punya
# link). GOOGLE_SERVICE_ACCOUNT_JSON bersifat opsional dan hanya
# meningkatkan keandalan pembacaan (memakai Sheets API langsung).
GOOGLE_SERVICE_ACCOUNT_JSON=""

# System Keys
ENCRYPTION_KEY="replace-with-a-random-32-byte-encryption-key"

# Student attendance device
# Send this value as `Authorization: Bearer ...` from the RFID/QR reader.
ATTENDANCE_DEVICE_TOKEN="replace-with-a-random-device-token"

# Fonnte WhatsApp gateway
FONNTE_TOKEN=""
FONNTE_ENABLED=false
FONNTE_WEBHOOK_SECRET="replace-with-a-random-webhook-secret"

# Scheduled maintenance (pembersihan log lama, lihat lib/retention.ts)
# Vercel Cron mengirim nilai ini sebagai `Authorization: Bearer ...`.
# Wajib diisi di production: tanpa ini endpoint pembersihan menolak permintaan.
CRON_SECRET="replace-with-a-random-cron-secret"
