{
  "name": "ke-digital-signage",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "lint": "eslint ."
  },
  "prisma": {
    "seed": "node --import tsx/esm prisma/seed.ts"
  },
  "dependencies": {
    "@googleapis/sheets": "^18.0.1",
    "@libsql/client": "^0.17.4",
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/adapter-libsql": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-table": "^8.21.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/pg": "^8.20.0",
    "argon2": "^0.45.1",
    "better-sqlite3": "^13.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dexie": "^4.4.4",
    "dexie-react-hooks": "^4.4.0",
    "jose": "^6.2.4",
    "lucide-react": "^1.27.0",
    "next": "^16.2.12",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "postcss": "^8.5.24",
    "prisma": "^7.9.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "rolldown": {
      "@napi-rs/wasm-runtime": "1.1.6"
    },
    "@rolldown/binding-wasm32-wasi": {
      "@napi-rs/wasm-runtime": "1.1.6"
    },
    "@unrs/resolver-binding-wasm32-wasi": {
      "@napi-rs/wasm-runtime": "1.1.4"
    },
    "@napi-rs/wasm-runtime": "1.1.6",
    "@prisma/adapter-better-sqlite3": {
      "better-sqlite3": "$better-sqlite3"
    }
  },
  "allowScripts": {
    "@prisma/engines": true,
    "argon2": true,
    "better-sqlite3": true,
    "esbuild": true,
    "prisma": true,
    "sharp": true,
    "unrs-resolver": true
  }
}
